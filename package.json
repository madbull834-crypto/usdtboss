{
  "name": "solidity-react-counter-dapp",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "security:slither": "slither . --exclude-dependencies",
    "security:production-deps": "npm audit --omit=dev",
    "preflight:mainnet:code": "npm run compile && npm test && npm run lint --workspace frontend && npm run test:unit --workspace frontend && npm run test:e2e --workspace frontend && npm run security:production-deps",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:bsc-testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:bsc-mainnet": "hardhat run scripts/deploy.ts --network bscMainnet",
    "migrate:local": "hardhat run scripts/migrate-registration.ts --network localhost",
    "migrate:bsc-testnet": "hardhat run scripts/migrate-registration.ts --network bscTestnet",
    "migrate:bsc-mainnet": "hardhat run scripts/migrate-registration.ts --network bscMainnet",
    "upgrade:local": "hardhat run scripts/upgrade.ts --network localhost",
    "upgrade:bsc-testnet": "hardhat run scripts/upgrade.ts --network bscTestnet",
    "upgrade:bsc-mainnet": "hardhat run scripts/upgrade.ts --network bscMainnet",
    "validate:v3:bsc-testnet": "hardhat run scripts/validate-v3-upgrade.ts --network bscTestnet",
    "validate:v4:bsc-testnet": "hardhat run scripts/validate-v4-upgrade.ts --network bscTestnet",
    "validate:v5:bsc-testnet": "hardhat run scripts/validate-v5-upgrade.ts --network bscTestnet",
    "validate:v5:bsc-mainnet": "hardhat run scripts/validate-v5-upgrade.ts --network bscMainnet",
    "validate:v6:bsc-testnet": "hardhat run scripts/validate-v6-upgrade.ts --network bscTestnet",
    "validate:v6:bsc-mainnet": "hardhat run scripts/validate-v6-upgrade.ts --network bscMainnet",
    "validate:v7:bsc-mainnet": "hardhat run scripts/validate-v7-correction.ts --network bscMainnet",
    "validate:v8:bsc-mainnet": "hardhat run scripts/validate-v8-global-pool.ts --network bscMainnet",
    "validate:v9:bsc-mainnet": "hardhat run scripts/validate-v9-matrix-registration.ts --network bscMainnet",
    "validate:v10:bsc-mainnet": "hardhat run scripts/validate-v10-account-address.ts --network bscMainnet",
    "validate:v11:bsc-mainnet": "hardhat run scripts/validate-v11-global-pool.ts --network bscMainnet",
    "audit:v11:bsc-mainnet": "hardhat run scripts/audit-v11-global-pool.ts --network bscMainnet",
    "correct:slot3:bsc-mainnet": "hardhat run scripts/upgrade-v7-correction.ts --network bscMainnet",
    "migrate:global-pool:v8:bsc-mainnet": "hardhat run scripts/upgrade-v8-global-pool.ts --network bscMainnet",
    "register:matrix:v9:bsc-mainnet": "hardhat run scripts/upgrade-v9-matrix-registration.ts --network bscMainnet",
    "migrate:account:v10:bsc-mainnet": "hardhat run scripts/upgrade-v10-account-address.ts --network bscMainnet",
    "activate:global-pool:v11:bsc-mainnet": "hardhat run scripts/upgrade-v11-global-pool.ts --network bscMainnet",
    "activate:legacy-global:v12:bsc-mainnet": "hardhat run scripts/upgrade-v12-legacy-global.ts --network bscMainnet",
    "audit:v12:bsc-mainnet": "hardhat run scripts/audit-v12-legacy-global.ts --network bscMainnet",
    "complete:legacy-level1:v13:bsc-mainnet": "hardhat run scripts/upgrade-v13-legacy-level-one.ts --network bscMainnet",
    "clear:legacy-global:v14:bsc-mainnet": "hardhat run scripts/upgrade-v14-clear-legacy-global.ts --network bscMainnet",
    "verify:bsc-mainnet": "hardhat verify --network bscMainnet",
    "verify:proxy:bsc-mainnet": "hardhat run scripts/verify-proxy-direct.ts --network bscMainnet",
    "withdraw:pool:bsc-testnet": "hardhat run scripts/withdraw-pool.ts --network bscTestnet",
    "withdraw:pool:bsc-mainnet": "hardhat run scripts/withdraw-pool.ts --network bscMainnet",
    "backfill:legacy-completion:bsc-testnet": "hardhat run scripts/backfill-legacy-completion.ts --network bscTestnet",
    "backfill:legacy-growth:bsc-testnet": "hardhat run scripts/backfill-legacy-growth.ts --network bscTestnet",
    "backfill:legacy-income:bsc-mainnet": "hardhat run scripts/backfill-legacy-income.ts --network bscMainnet",
    "backfill:legacy-global:bsc-mainnet": "hardhat run scripts/backfill-legacy-global.ts --network bscMainnet",
    "backfill:legacy-completion:bsc-mainnet": "hardhat run scripts/backfill-legacy-completion.ts --network bscMainnet",
    "backfill:legacy-growth:bsc-mainnet": "hardhat run scripts/backfill-legacy-growth.ts --network bscMainnet",
    "frontend:bsc-testnet": "npm run dev --workspace frontend -- --mode bsc-testnet --host 127.0.0.1",
    "frontend:build:bsc-testnet": "npm run build --workspace frontend -- --mode bsc-testnet",
    "frontend:build:bsc-mainnet": "npm run preflight:production --workspace frontend && npm run build --workspace frontend -- --mode bsc-mainnet",
    "frontend:dev": "npm run dev --workspace frontend",
    "frontend:build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.10.2",
    "hardhat": "^2.22.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
