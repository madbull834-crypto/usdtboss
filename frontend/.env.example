VITE_CHAIN_ID=31337
VITE_BOSS_ADDRESS=
VITE_RPC_URL=http://127.0.0.1:8545
VITE_DEPLOYMENT_BLOCK=0

# Archive RPC(s) used only for eth_getLogs (income history + matrix placements).
# Comma-separated, tried in order. Free public BSC-testnet nodes either prune
# logs or rate-limit wide ranges, which makes income and the trees load empty —
# point this at a keyed archive endpoint (Alchemy / QuickNode / Ankr / NodeReal).
# Defaults to onfinality + VITE_RPC_URL, neither of which can serve full history.
VITE_LOGS_RPC_URLS=
